---
export const prerender = false;
import LandingLayout from '../../layouts/LandingLayout.astro';
import MicrositeFooter from '../../components/MicrositeFooter.astro';
import MicrositeHeader from '../../components/MicrositeHeader.astro';
import TreatmentPage from '../../components/TreatmentPage.astro';
import { getLandingPage } from '../../lib/landingPage';
const page = await getLandingPage('landing-bed-bug-treatment');
const title = page?.seo?.seoTitle ?? 'Bed Bug Treatment | EverGreen Bed Bug Exterminator';
const description = page?.seo?.seoDescription;
---
<LandingLayout title={title} description={description}>
  <MicrositeHeader currentPath="/bed-bug-treatment/" />
  {page?.sections?.length ? <TreatmentPage page={page} /> : null}
  <MicrositeFooter />
</LandingLayout>
