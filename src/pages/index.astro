---
export const prerender = false;

import HomePage from '../components/HomePage.astro';
import LandingLayout from '../layouts/LandingLayout.astro';
import { getLandingPage } from '../lib/landingPage';
import MicrositeFooter from '../components/MicrositeFooter.astro';
import MicrositeHeader from '../components/MicrositeHeader.astro';

const page = await getLandingPage('landing-page');
const title = page?.seo?.seoTitle ?? page?.title ?? 'EverGreen Bed Bug Exterminator';
const description = page?.seo?.seoDescription;
---

<LandingLayout title={title} description={description}>
  <MicrositeHeader currentPath="/" />
  {page?.sections?.length ? <HomePage page={page} /> : null}
  <MicrositeFooter />
</LandingLayout>
