---
export const prerender = false;

import LandingLayout from '../layouts/LandingLayout.astro';
import { getLandingPage } from '../lib/landingPage';
import { buildSanityImageUrl } from '../lib/sanity';

const page = await getLandingPage();
const hero = page?.sections?.find((section) => section._type === 'heroSection');
const heroImage = hero?.backgroundImage
  ? buildSanityImageUrl(hero.backgroundImage, { width: 1800, quality: 82 })
  : undefined;
const title = page?.seo?.seoTitle ?? page?.title ?? 'Evergreen landing page';
const description = page?.seo?.seoDescription;
---

<LandingLayout title={title} description={description}>
  <main id="main-content">
    <section class="hero" style={heroImage ? `background-image: linear-gradient(90deg, rgba(16, 47, 32, .94), rgba(16, 47, 32, .56)), url(${heroImage})` : undefined}>
      <div class="shell hero__content">
        <p class="eyebrow">Evergreen</p>
        <h1>{hero?.title ?? page?.title ?? 'Landing page setup in progress'}</h1>
        {hero?.subtitle && <p class="lede">{hero.subtitle}</p>}
        {hero?.primaryCtaLabel && hero?.primaryCtaLink && <a class="button" href={hero.primaryCtaLink}>{hero.primaryCtaLabel}</a>}
      </div>
    </section>

    {!page && (
      <section class="setup" aria-labelledby="setup-title">
        <div class="shell narrow">
          <p class="eyebrow">CMS connection ready</p>
          <h2 id="setup-title">Add the approved landing-page content in Sanity.</h2>
          <p>Set the Sanity environment variables, then create a <code>page</code> document with the <code>landing-page</code> page type and the configured landing-page slug. This temporary message is intentionally not customer-facing copy.</p>
        </div>
      </section>
    )}
  </main>
</LandingLayout>

<style>
  .hero { min-height: min(680px, 82vh); display: grid; align-items: center; background-color: #123a2a; background-position: center; background-size: cover; color: #fff; }
  .hero__content { padding-block: 8rem; }
  .eyebrow { color: #b7d873; font-size: .8rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  h1 { max-width: 15ch; margin: .4rem 0 1rem; font-size: clamp(2.75rem, 7vw, 5.6rem); line-height: .98; }
  .lede { max-width: 56ch; font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.6; }
  .button { display: inline-block; margin-top: 1rem; padding: .9rem 1.35rem; border-radius: .4rem; background: #b7d873; color: #173522; font-weight: 800; text-decoration: none; }
  .setup { padding-block: 5rem; background: #f4f5ef; }
  .narrow { max-width: 720px; }
  h2 { font-size: clamp(2rem, 5vw, 3.3rem); line-height: 1.05; }
  code { padding: .1em .3em; border-radius: .2rem; background: #e4e8dd; }
</style>
