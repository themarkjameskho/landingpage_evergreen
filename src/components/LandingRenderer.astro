---
import type { FaqSection, HeroSection, IconGridSection, LandingSection, ServiceGridSection, TwoColumnSection } from '../types/cms';
import { buildSanityImageUrl } from '../lib/sanity';
interface Props { sections: LandingSection[]; }
const { sections } = Astro.props;
const imageUrl = (image: Parameters<typeof buildSanityImageUrl>[0] | undefined, width: number, height: number) => image ? buildSanityImageUrl(image, { width, height, fit: 'crop', quality: 82 }) : undefined;
const portableText = (blocks: TwoColumnSection['description']) => blocks?.flatMap((block) => block.children?.map((child) => child.text?.trim()).filter(Boolean) ?? []).join(' ');
---
{sections.map((section) => {
  if (section._type === 'heroSection') {
    const hero = section as HeroSection; const src = imageUrl(hero.sideImage ?? hero.backgroundImage, 1600, 900);
    return <section class="hero" aria-labelledby={`section-${hero._key}`}><div class="shell hero-grid"><div><h1 id={`section-${hero._key}`}>{hero.title}</h1>{hero.subtitle && <p class="hero-copy">{hero.subtitle}</p>}<div class="actions">{hero.primaryCtaLabel && hero.primaryCtaLink && <a class="button accent" href={hero.primaryCtaLink}>{hero.primaryCtaLabel}</a>}{hero.secondaryCtaLabel && hero.secondaryCtaLink && <a class="button quiet" href={hero.secondaryCtaLink}>{hero.secondaryCtaLabel}</a>}</div></div>{src && <img class="hero-image" src={src} alt={hero.sideImage?.alt ?? hero.backgroundImage?.alt ?? ''} width="800" height="600" loading="eager" fetchpriority="high" />}</div></section>;
  }
  if (section._type === 'twoColTextImageSection') {
    const item = section as TwoColumnSection; const image = item.images?.[0]; const src = imageUrl(image, 1200, 900); const copy = portableText(item.description);
    return <section class="two-col" aria-labelledby={`section-${item._key}`}><div class:list={['shell', 'two-grid', item.imagePlacement === 'imageLeft' && 'image-left']}>{src && <img src={src} alt={image?.alt ?? ''} width="700" height="525" loading="lazy" />}{<div><h2 id={`section-${item._key}`}>{item.title}</h2>{item.subtitle && <p class="lede">{item.subtitle}</p>}{copy && <p>{copy}</p>}{item.bullets?.length ? <ul>{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul> : null}{item.ctaLabel && item.ctaLink && <a class="text-link" href={item.ctaLink}>{item.ctaLabel}</a>}</div>}</div></section>;
  }
  if (section._type === 'iconGridSection') {
    const grid = section as IconGridSection;
    return <section class="proof" aria-labelledby={`section-${grid._key}`}><div class="shell"><div class="heading"><h2 id={`section-${grid._key}`}>{grid.title}</h2>{grid.subtitle && <p>{grid.subtitle}</p>}</div><div class="proof-grid">{grid.items?.map((item) => { const src = imageUrl(item.icon, 160, 160); return <article>{src && <img src={src} alt="" width="80" height="80" loading="lazy" />}<h3>{item.label}</h3>{item.description && <p>{item.description}</p>}{item.ctaLabel && item.ctaLink && <a class="text-link" href={item.ctaLink}>{item.ctaLabel}</a>}</article>; })}</div></div></section>;
  }
  if (section._type === 'serviceGridSection') {
    const grid = section as ServiceGridSection;
    return <section class="services" aria-labelledby={`section-${grid._key}`}><div class="shell"><div class="heading"><h2 id={`section-${grid._key}`}>{grid.title}</h2>{grid.subtitle && <p>{grid.subtitle}</p>}</div><div class:list={['services-grid', grid.desktopColumns === 2 && 'two-up']}>{grid.items?.map((item) => { const image = item.imageDisplay === 'icon' ? item.icon : item.image; const src = imageUrl(image, 900, 563); return <article class="service-card">{src && <img src={src} alt={image?.alt ?? ''} width="600" height="400" loading="lazy" />}<div><h3>{item.label}</h3>{item.description && <p>{item.description}</p>}{item.linkLabel && item.linkUrl && <a class="text-link" href={item.linkUrl}>{item.linkLabel}</a>}</div></article>; })}</div></div></section>;
  }
  if (section._type === 'faqSection') {
    const faq = section as FaqSection;
    return <section class="faq" aria-labelledby={`section-${faq._key}`}><div class="shell faq-grid"><div class="faq-intro"><h2 id={`section-${faq._key}`}>{faq.heading ?? faq.title}</h2>{faq.description && <p>{faq.description}</p>}{faq.buttonLabel && faq.buttonLink && <a class="button accent" href={faq.buttonLink}>{faq.buttonLabel}</a>}</div><div class="faq-items">{faq.faqs?.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></div></section>;
  }
  return null;
})}
<style>
  section { padding-block: clamp(4.5rem, 9vw, 8rem); } h1,h2,h3,p { margin-top: 0; } h1 { max-width: 20ch; font-size: clamp(2.8rem,4vw,3.8rem); line-height:.98; letter-spacing:-.065em; } h2 { max-width:15ch; color:var(--ink); font-size:clamp(2.1rem,4vw,4rem); line-height:1; letter-spacing:-.055em; } h3 { color:var(--ink); font-size:1.28rem; line-height:1.2; } p { color:var(--muted); line-height:1.65; } .hero { padding-block:clamp(2.75rem,6vw,5rem); background:var(--surface); } .hero-grid { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(340px,.9fr); align-items:center; gap:clamp(2rem,5vw,4.5rem); } .hero-copy { max-width:43ch; font-size:clamp(1.1rem,1.6vw,1.35rem); } .hero-image { width:100%; min-height:440px; object-fit:cover; border-radius:var(--radius); box-shadow:0 26px 65px rgb(19 62 42 / .18); } .actions { display:flex; flex-wrap:wrap; gap:.8rem; margin-top:1.8rem; } .button { display:inline-flex; min-height:48px; align-items:center; justify-content:center; padding:.75rem 1.1rem; border-radius:999px; font-weight:800; line-height:1; text-decoration:none; white-space:nowrap; } .accent { background:var(--accent); color:#183621; } .quiet { border:1px solid var(--line-strong); color:var(--forest); } .two-col,.services { background:var(--tint); } .two-grid { display:grid; grid-template-columns:minmax(290px,.95fr) minmax(0,1fr); align-items:center; gap:clamp(2.25rem,7vw,7rem); } .two-grid.image-left img { order:-1; } .two-grid img { width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:var(--radius); } .lede { font-size:1.15rem; } ul { display:grid; gap:.7rem; padding-left:1.2rem; color:var(--muted); line-height:1.5; } li::marker { color:var(--accent-deep); } .text-link { color:var(--forest); font-weight:800; text-underline-offset:.25em; } .heading { max-width:640px; margin-bottom:2.5rem; } .proof { background:var(--surface); } .proof-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line); border:1px solid var(--line); border-radius:var(--radius); overflow:hidden; } .proof-grid article { min-height:200px; padding:1.7rem; background:var(--surface); } .proof-grid img { width:42px; height:42px; object-fit:contain; } .proof-grid h3 { margin:1.1rem 0 .55rem; } .proof-grid p { margin-bottom:0; font-size:.95rem; } .services-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.25rem; } .services-grid.two-up { grid-template-columns:repeat(2,1fr); } .service-card { overflow:hidden; border:1px solid var(--line); border-radius:var(--radius); background:var(--surface); box-shadow:0 13px 28px rgb(19 62 42 / .07); } .service-card img { width:100%; aspect-ratio:16/10; object-fit:cover; } .service-card > div { padding:1.5rem; } .service-card h3 { margin-bottom:.6rem; } .faq { background:var(--surface); } .faq-grid { display:grid; grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr); gap:clamp(2.5rem,8vw,8rem); } .faq-intro { align-self:start; position:sticky; top:1.5rem; } .faq-intro .button { margin-top:1rem; } .faq-items { border-top:1px solid var(--line); } details { border-bottom:1px solid var(--line); padding:1.15rem 0; } summary { cursor:pointer; color:var(--ink); font-size:1.08rem; font-weight:800; } details p { max-width:68ch; margin:.9rem 1.5rem .25rem 0; } @media (max-width:840px) { .hero-grid,.two-grid,.faq-grid { grid-template-columns:1fr; } .hero-image { min-height:auto; aspect-ratio:4/3; } .two-grid.image-left img { order:initial; } .faq-intro { position:static; } .proof-grid,.services-grid,.services-grid.two-up { grid-template-columns:repeat(2,1fr); } } @media (max-width:560px) { section { padding-block:4rem; } .proof-grid,.services-grid,.services-grid.two-up { grid-template-columns:1fr; } .hero-image { min-height:0; } .actions .button { width:100%; } } @media (prefers-reduced-motion:no-preference) { .service-card,.button { transition:transform 180ms ease,box-shadow 180ms ease,background 180ms ease; } .service-card:hover { transform:translateY(-3px); box-shadow:0 18px 36px rgb(19 62 42 / .12); } .button:active { transform:translateY(1px); } }
</style>
