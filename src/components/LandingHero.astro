---
import type { HeroSection, SanityImage } from '../types/cms';
import { buildSanityImageUrl } from '../lib/sanity';
import CallCard from './CallCard.astro';

const { hero, eyebrow = 'EverGreen Bed Bug Exterminator', showActions = true } = Astro.props as { hero: HeroSection; eyebrow?: string; showActions?: boolean };
const imageUrl = (image: SanityImage | undefined, width: number, height: number) =>
  image ? buildSanityImageUrl(image, { width, height, fit: 'crop', quality: 84 }) : undefined;
const backgroundImage = imageUrl(hero.backgroundImage, 2200, 1200);
const backgroundImageMobile = imageUrl(hero.backgroundImage, 900, 1200);
const sideImage = imageUrl(hero.sideImage, 1100, 1100);
const hasHomeScene = hero._key === 'landing-hero' && Boolean(backgroundImage);
const hasTreatmentScene = hero._key === 'treatment-hero' && Boolean(backgroundImage);
const overlay = hero.overlayVariant ?? 'darkGreen';
---

<section class:list={['landing-hero', `landing-hero--${overlay}`, hero._key === 'landing-hero' && 'landing-hero--home', hero._key === 'treatment-hero' && 'landing-hero--treatment', sideImage && 'landing-hero--with-side']} style={backgroundImage ? `--hero-image:url('${backgroundImage}');${backgroundImageMobile ? `--hero-image-mobile:url('${backgroundImageMobile}')` : ''}` : undefined}>
  <div class="landing-hero__shade"></div>
  <div class="landing-hero__inner">
    <div class="landing-hero__content">
      <p class="kicker">{eyebrow}</p>
      <h1>{hero.title}</h1>
      {hero.subtitle && <p class="landing-hero__lede">{hero.subtitle}</p>}
      {showActions && ((hero.primaryCtaLabel && hero.primaryCtaLink) || (hero.secondaryCtaLabel && hero.secondaryCtaLink)) ? <div class="landing-hero__actions">
        {hero.primaryCtaLabel && hero.primaryCtaLink && (hasHomeScene ? <CallCard href={hero.primaryCtaLink} /> : <a class="btn-secondary" href={hero.primaryCtaLink}>{hero.primaryCtaLabel}</a>)}
        {hero.secondaryCtaLabel && hero.secondaryCtaLink && <a class="btn-ghost" href={hero.secondaryCtaLink}>{hero.secondaryCtaLabel}</a>}
      </div> : null}
      {hasHomeScene && <div class="landing-hero__meta"><span>Locally owned &amp; operated</span><span>Total discretion</span><span>Same day service</span></div>}
    </div>
    {(hasHomeScene || sideImage || hasTreatmentScene) && <div class="landing-hero__visual" role={hasHomeScene ? 'img' : undefined} aria-label={hasHomeScene ? hero.backgroundImage?.alt ?? '' : undefined}>
      {hasHomeScene ? <>
        <span class="landing-hero__scene-tag">EverGreen Bed Bug Exterminator</span><span class="landing-hero__scene-badge" style="position:absolute;top:.7rem;right:.7rem;min-width:80px;display:grid;justify-items:center;padding:.4rem .5rem;border:1px solid var(--line);border-radius:9px;background:rgb(248 250 246 / .95);color:var(--evergreen-950);text-align:center;box-shadow:0 8px 18px rgb(13 47 31 / .13)"><strong style="font-size:1.3rem;line-height:1;font-weight:800;letter-spacing:-.06em">10+</strong><small style="margin-top:.2rem;font-size:.49rem;font-weight:700;line-height:1.1;text-transform:uppercase">years of<br/>experience</small></span>
      </> : hasTreatmentScene ? <div class="landing-hero__scene" role="img" aria-label={hero.backgroundImage?.alt ?? ''}></div> : <img src={sideImage} alt={hero.sideImage?.alt ?? ''} width="1100" height="1100" loading="eager" fetchpriority="high" />}
    </div>}
  </div>
</section>

<style>
  .landing-hero { position:relative; min-height:min(700px,calc(100dvh - 86px)); overflow:hidden; isolation:isolate; background:var(--hero-image,none) center/cover no-repeat,var(--evergreen-950); color:white; }
  .landing-hero__shade { position:absolute; inset:0; z-index:-1; background:var(--hero-overlay); }
  .landing-hero--darkGreen { --hero-overlay:linear-gradient(90deg,rgb(8 33 20 / .94),rgb(8 33 20 / .78),rgb(8 33 20 / .24)); }
  .landing-hero--evergreen { --hero-overlay:linear-gradient(90deg,rgb(21 60 41 / .9),rgb(29 85 57 / .68),rgb(165 207 99 / .18)); }
  .landing-hero--lightGreen { --hero-overlay:linear-gradient(90deg,rgb(237 244 234 / .94),rgb(237 244 234 / .7),rgb(199 232 139 / .26)); color:var(--ink); }
  .landing-hero--lightGreen .landing-hero__lede { color:var(--muted); }
  .landing-hero--lightGreen .kicker { color:var(--evergreen-800); }
  .landing-hero--lightGreen .btn-ghost { border-color:var(--evergreen-800); color:var(--evergreen-800); }
  .landing-hero--none { --hero-overlay:linear-gradient(90deg,rgb(8 33 20 / .35),rgb(8 33 20 / .1),transparent); }
  .landing-hero--treatment { background-position:center; }
  .landing-hero__inner { width:min(1320px,calc(100% - 3rem)); min-height:inherit; display:grid; grid-template-columns:minmax(0,1fr) minmax(360px,.85fr); align-items:stretch; margin:auto; }
  .landing-hero__content { align-self:center; padding:clamp(3rem,6vw,5rem) 0; }
  .landing-hero__content h1 { max-width:720px; margin-bottom:1rem; font-size:clamp(3rem,6vw,5.5rem); line-height:.97; letter-spacing:-.065em; }
  .landing-hero__lede { max-width:620px; margin-bottom:2rem; color:rgb(255 255 255 / .87); font-size:clamp(1.05rem,1.7vw,1.25rem); }
  .landing-hero__actions { display:flex; flex-wrap:wrap; gap:.8rem; }
  .landing-hero__visual { display:flex; min-height:inherit; align-items:flex-end; justify-content:center; }
  .landing-hero__visual img { display:block; width:min(100%,620px); height:100%; object-fit:contain; object-position:center bottom; }
  @media(max-width:900px) { .landing-hero { min-height:min(650px,133.333vw); background-image:var(--hero-image-mobile,var(--hero-image)); background-position:center; background-size:cover; background-repeat:no-repeat; }.landing-hero__inner { grid-template-columns:1fr; width:min(100% - 1.5rem,680px); }.landing-hero__content { padding:4.5rem 0 2rem; }.landing-hero__visual { min-height:360px; }.landing-hero__visual img { height:360px; }.landing-hero__content h1 { font-size:clamp(2.75rem,12vw,4rem); }.landing-hero__actions { flex-direction:column; align-items:stretch; gap:.45rem; }.landing-hero__actions .btn-secondary { width:100%; }.landing-hero__actions .btn-ghost { align-self:center; min-height:0; padding:.35rem 0; border:0; background:transparent; box-shadow:none; }.landing-hero__actions .btn-ghost::before { display:none; } }
  .landing-hero--home{min-height:0;padding:clamp(3.5rem,6vw,6rem) 0;background:radial-gradient(70% 70% at 100% 0%,rgb(199 232 139 / .2),transparent 65%),radial-gradient(60% 60% at 0% 100%,rgb(237 244 234 / .9),transparent 70%),var(--paper);color:var(--ink)}
  .landing-hero--home .landing-hero__shade{display:none}
  .landing-hero--home .landing-hero__inner{width:min(1180px,calc(100% - 3rem));min-height:0;grid-template-columns:minmax(0,.92fr) minmax(0,1fr);align-items:center;gap:clamp(2.5rem,6vw,6rem)}
  .landing-hero--home .landing-hero__content{padding:0}
  .landing-hero--home .kicker{color:var(--evergreen-800);font-size:.72rem;letter-spacing:.15em;text-transform:uppercase}
  .landing-hero--home h1{max-width:630px;margin-bottom:1.4rem;color:var(--evergreen-950);font-size:clamp(3.3rem,5vw,5.35rem);line-height:.98}
  .landing-hero--home .landing-hero__lede{max-width:53ch;margin-bottom:1.8rem;color:var(--muted);font-size:1.05rem;line-height:1.55}
  .landing-hero--home .landing-hero__visual{position:relative;display:block;min-height:0;aspect-ratio:3/2;overflow:hidden;border-radius:var(--radius);background:var(--hero-image) center/cover no-repeat,var(--evergreen-900);box-shadow:0 22px 42px rgb(13 47 31 / .13)}
  .landing-hero--home .landing-hero__scene-tag{position:absolute;top:1rem;left:1rem;padding:.4rem .6rem;border-radius:6px;background:rgb(248 250 246 / .9);color:var(--evergreen-900);font-size:.62rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;backdrop-filter:blur(8px)}
  .landing-hero--home .landing-hero__scene-badge{position:absolute;top:1rem;right:1rem;min-width:98px;display:grid;justify-items:center;padding:.6rem .8rem;border:1px solid var(--line);border-radius:9px;background:rgb(248 250 246 / .95);color:var(--evergreen-950);text-align:center;box-shadow:0 8px 18px rgb(13 47 31 / .13)}
  .landing-hero--home .landing-hero__scene-badge strong{font-size:1.55rem;line-height:1;font-weight:800;letter-spacing:-.06em}.landing-hero--home .landing-hero__scene-badge small{margin-top:.25rem;font-size:.55rem;font-weight:700;line-height:1.1;text-transform:uppercase}
  .landing-hero--home .btn-secondary{background:var(--evergreen-900);color:white}
  .landing-hero--home .btn-secondary:hover{background:var(--evergreen-800);color:white}
  .landing-hero--home .btn-ghost{border-color:var(--evergreen-800);color:var(--evergreen-800)}
  .landing-hero--home .btn-ghost:hover{background:var(--mist)}
  .landing-hero--home .landing-hero__actions{flex-direction:column;align-items:flex-start;gap:.55rem}
  .landing-hero--home .landing-hero__actions{width:min(100%,460px);gap:.75rem}
  .landing-hero--home .landing-hero__actions .btn-ghost{min-height:44px;padding:.7rem 1.2rem;border-color:var(--line);color:var(--evergreen-900);font-size:.85rem}
  .landing-hero__meta{display:flex;flex-wrap:wrap;gap:.55rem 1.15rem;margin-top:1.3rem;color:var(--muted);font-size:.73rem;font-weight:600}
  .landing-hero__meta span::before{content:'✓';margin-right:.4rem;color:var(--evergreen-800);font-weight:800}
  .landing-hero--treatment{min-height:0;padding:clamp(4rem,7vw,7rem) 0;background:var(--paper);color:var(--ink)}
  .landing-hero--treatment .landing-hero__shade{display:none}
  .landing-hero--treatment .landing-hero__inner{width:min(1180px,calc(100% - 3rem));min-height:0;grid-template-columns:minmax(0,.95fr) minmax(0,1fr);align-items:center;gap:clamp(2.5rem,6vw,6rem)}
  .landing-hero--treatment .landing-hero__content{padding:0}
  .landing-hero--treatment .kicker{color:var(--evergreen-800);font-size:.72rem;letter-spacing:.15em;text-transform:uppercase}
  .landing-hero--treatment h1{max-width:630px;margin-bottom:1.4rem;color:var(--evergreen-950);font-size:clamp(3.3rem,5vw,5.35rem);line-height:.98}
  .landing-hero--treatment .landing-hero__lede{max-width:53ch;margin-bottom:1.8rem;color:var(--muted);font-size:1.05rem;line-height:1.55}
  .landing-hero--treatment .landing-hero__visual{min-height:420px;overflow:hidden;border-radius:var(--radius);background:var(--evergreen-900)}
  .landing-hero--treatment .landing-hero__scene{width:100%;height:420px;background:var(--hero-image) center/cover no-repeat}
  .landing-hero--treatment .btn-secondary{background:var(--evergreen-900);color:white}
  .landing-hero--treatment .btn-secondary:hover{background:var(--evergreen-800);color:white}
  .landing-hero--treatment .btn-ghost{border-color:var(--evergreen-800);color:var(--evergreen-800)}
  @media(max-width:900px){.landing-hero--home{padding:3.5rem 0}.landing-hero--home .landing-hero__inner{width:min(100% - 1.5rem,680px);grid-template-columns:1fr;gap:2rem}.landing-hero--home .landing-hero__content{padding:0}.landing-hero--home .landing-hero__actions .btn-ghost{border:1px solid var(--evergreen-800);padding:1rem 1.625rem;align-self:stretch}}
  @media(max-width:900px){.landing-hero--treatment{padding:3.5rem 0}.landing-hero--treatment .landing-hero__inner{width:min(100% - 1.5rem,680px);grid-template-columns:1fr;gap:2rem}.landing-hero--treatment .landing-hero__content{padding:0}.landing-hero--treatment .landing-hero__visual{min-height:360px}.landing-hero--treatment .landing-hero__scene{height:360px}}
  @media(max-width:560px){.landing-hero--home{padding:2.5rem 0}.landing-hero--home h1{font-size:clamp(2.9rem,12vw,4rem)}.landing-hero--home .landing-hero__visual{aspect-ratio:4/3}.landing-hero--home .landing-hero__scene-tag{top:.7rem;left:.7rem;max-width:180px;white-space:normal;font-size:.52rem}.landing-hero--home .landing-hero__scene-badge{top:.7rem;right:.7rem;min-width:65px;padding:.35rem}.landing-hero--home .landing-hero__scene-badge strong{font-size:1.1rem}.landing-hero--home .landing-hero__scene-badge small{font-size:.43rem}}
  @media(max-width:560px){.landing-hero--treatment{padding:2.5rem 0}.landing-hero--treatment h1{font-size:clamp(2.9rem,12vw,4rem)}.landing-hero--treatment .landing-hero__visual{min-height:280px}.landing-hero--treatment .landing-hero__scene{height:280px}}
</style>
