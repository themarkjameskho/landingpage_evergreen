---
const { href = 'tel:+14793973936', phone = '(479) 397-3936', eyebrow = 'Call now · Free consultation' } = Astro.props as { href?: string; phone?: string; eyebrow?: string };
---

<a class="call-card" href={href} aria-label={`Call EverGreen at ${phone}`}>
  <span class="call-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 3.1 5.2 2 2 0 0 1 5.1 3h3a2 2 0 0 1 2 1.7l.4 2.7a2 2 0 0 1-.6 1.8L8.4 10.7a16 16 0 0 0 4.9 4.9l1.5-1.5a2 2 0 0 1 1.8-.6l2.7.4a2 2 0 0 1 1.7 2Z"/></svg></span>
  <span class="call-card__copy"><small>{eyebrow}</small><strong>{phone}</strong></span>
  <span class="call-card__arrow" aria-hidden="true">→</span>
</a>

<style>
  .call-card{width:100%;min-height:83px;display:flex;align-items:center;gap:1.1rem;padding:1.1rem 1.35rem;border-radius:12px;background:var(--leaf);color:var(--evergreen-950);box-shadow:0 14px 30px rgb(13 47 31 / .18);text-decoration:none;transition:transform .2s,background .2s,box-shadow .2s}
  .call-card:hover{transform:translateY(-2px);background:var(--leaf-light);box-shadow:0 17px 34px rgb(13 47 31 / .22)}
  .call-card__icon{position:relative;flex:none;width:46px;height:46px;display:grid;place-items:center;border-radius:50%;background:var(--evergreen-900);color:white}
  .call-card__icon::after{position:absolute;inset:-4px;border:2px solid var(--evergreen-900);border-radius:50%;content:'';opacity:.28;animation:call-pulse 2s ease-out infinite}
  .call-card__icon svg{width:21px;height:21px}
  .call-card__copy{min-width:0;display:grid;gap:.2rem;line-height:1.1}
  .call-card__copy small{font-size:.65rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  .call-card__copy strong{font-size:clamp(1.45rem,2.6vw,2rem);font-weight:800;letter-spacing:-.04em;white-space:nowrap}
  .call-card__arrow{margin-left:auto;font-size:1.5rem;line-height:1;transition:transform .2s}
  .call-card:hover .call-card__arrow{transform:translateX(4px)}
  @keyframes call-pulse{to{transform:scale(1.7);opacity:0}}
  @media(max-width:560px){.call-card{min-height:74px;gap:.8rem;padding:.85rem 1rem}.call-card__icon{width:42px;height:42px}.call-card__copy strong{font-size:1.55rem}.call-card__copy small{font-size:.56rem}}
  @media(prefers-reduced-motion:reduce){.call-card__icon::after{animation:none}}
</style>
