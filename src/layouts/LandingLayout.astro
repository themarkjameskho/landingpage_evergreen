---
interface Props { title: string; description?: string; }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description ?? 'EverGreen bed bug treatment information.'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0d2f1f" />
    <script is:inline type="text/javascript" src="//cdn.callreports.com/companies/878744666/3fda750a23f4b606a37a/12/swap.js"></script>
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>

<style is:global>
  :root { --evergreen-950:#0d2f1f; --evergreen-900:#153c29; --evergreen-800:#1d5539; --leaf:#a5cf63; --leaf-light:#c7e88b; --mist:#edf4ea; --paper:#f8faf6; --ink:#12261a; --muted:#48604f; --line:#d8e4d7; --radius:14px; font-family:'IBM Plex Sans','Open Sans',Arial,sans-serif; color:var(--ink); background:var(--paper); color-scheme:light; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { min-width:320px; margin:0; background:var(--paper); color:var(--ink); line-height:1.6; }
  img { max-width:100%; }
  h1,h2,h3,p { margin-top:0; }
  h1,h2,h3 { color:inherit; font-family:'IBM Plex Sans','Open Sans',Arial,sans-serif; }
  a:focus-visible, summary:focus-visible { outline:3px solid var(--leaf-light); outline-offset:4px; }
  .btn-primary,.btn-secondary,.btn-ghost { display:inline-flex; align-items:center; justify-content:center; gap:.625rem; min-height:54px; padding:1rem 1.625rem; border:1px solid transparent; border-radius:999px; font-family:inherit; font-size:.875rem; font-weight:700; letter-spacing:-.005em; line-height:1; text-decoration:none; white-space:nowrap; position:relative; overflow:hidden; isolation:isolate; transition:transform 220ms cubic-bezier(.2,.8,.2,1),background 220ms cubic-bezier(.2,.8,.2,1),gap 180ms cubic-bezier(.23,1,.32,1),box-shadow 220ms cubic-bezier(.2,.8,.2,1); }
  .btn-primary::before,.btn-secondary::before,.btn-ghost::before { position:absolute; inset:0; background:linear-gradient(120deg,transparent 38%,rgb(255 255 255 / .38) 50%,transparent 62%); content:''; transform:translateX(-120%); transition:transform 700ms cubic-bezier(.2,.8,.2,1); pointer-events:none; }
  .btn-primary:hover::before,.btn-secondary:hover::before,.btn-ghost:hover::before { transform:translateX(120%); }
  .btn-primary > *,.btn-secondary > *,.btn-ghost > * { position:relative; z-index:1; }
  .btn-primary { background:var(--evergreen-900); color:white; box-shadow:0 10px 24px rgb(13 47 31 / .16); }
  .btn-primary:hover { background:var(--evergreen-800); transform:translateY(-2px); box-shadow:0 14px 30px rgb(13 47 31 / .22); }
  .btn-secondary { background:var(--leaf); color:#102d1e; }
  .btn-secondary:hover { background:var(--leaf-light); transform:translateY(-2px); box-shadow:0 14px 30px rgb(13 47 31 / .18); }
  .btn-ghost { border-color:rgb(255 255 255 / .6); color:white; }
  .btn-ghost:hover { background:rgb(255 255 255 / .12); transform:translateY(-2px); }
  .btn-primary:active,.btn-secondary:active,.btn-ghost:active { transform:translateY(1px); }
  @media (prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } *,*::before,*::after { animation-duration:.01ms !important; animation-iteration-count:1 !important; transition-duration:.01ms !important; } }
</style>
